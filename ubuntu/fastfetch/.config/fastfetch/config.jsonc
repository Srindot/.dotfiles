{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ╭──────────────────────────────────────────────╮
    // │                    LOGO                      │
    // ╰──────────────────────────────────────────────╯

    "logo": {
        "type": "kitty-direct",
        "source": "/home/sriney/.config/fastfetch/rosepine.png",

        "width": 23,
        "height": 10,

        "padding": {
            "top": 1,
            "left": 5,
            "right": 5
        }
    },

    // ╭──────────────────────────────────────────────╮
    // │                 ROSE PINE                    │
    // ╰──────────────────────────────────────────────╯
    //
    // Base:      #191724
    // Surface:   #1f1d2e
    // Overlay:   #26233a
    // Muted:     #6e6a86
    // Subtle:    #908caa
    // Text:      #e0def4
    //
    // Love:      #eb6f92
    // Gold:      #f6c177
    // Rose:      #ebbcba
    // Pine:      #31748f
    // Foam:      #9ccfd8
    // Iris:      #c4a7e7

    "display": {
        "separator": " \u001b[38;2;110;106;134m→\u001b[0m "
    },

    "modules": [

        "break",

        // ──────────────────────────────────────────
        // USER
        // ──────────────────────────────────────────

        {
            "type": "title",
            "keyWidth": 10,
            "format":
                "         \u001b[38;2;235;111;146m{6}\u001b[38;2;235;188;186m{7}\u001b[38;2;156;207;216m{8}\u001b[0m"
        },

        {
            "type": "custom",
            "format":
                " \u001b[38;2;110;106;134m──────────────\u001b[38;2;196;167;231m\u001b[38;2;110;106;134m──────────────\u001b[0m "
        },


        // ──────────────────────────────────────────
        // SYSTEM
        // ──────────────────────────────────────────

        {
            "type": "kernel",
            "key": "\u001b[38;2;196;167;231m\u001b[0m ",
            "keyColor": "#c4a7e7"
        },

        {
            "type": "wm",
            "key": "\u001b[38;2;156;207;216m\u001b[0m ",
            "keyColor": "#9ccfd8"
        },

        {
            "type": "shell",
            "key": "\u001b[38;2;246;193;119m\u001b[0m ",
            "keyColor": "#f6c177"
        },

        {
            "type": "terminal",
            "key": "\u001b[38;2;235;188;186m\u001b[0m ",
            "keyColor": "#ebbcba"
        },

        {
            "type": "memory",
            "key": "\u001b[38;2;49;116;143m󰍛\u001b[0m ",
            "keyColor": "#31748f",
            "format": "{1} / {2}"
        },

        {
            "type": "uptime",
            "key": "\u001b[38;2;235;111;146m󰔛\u001b[0m ",
            "keyColor": "#eb6f92"
        },


        // ──────────────────────────────────────────
        // END
        // ──────────────────────────────────────────

        {
            "type": "custom",
            "format":
                " \u001b[38;2;110;106;134m──────────────\u001b[38;2;196;167;231m\u001b[38;2;110;106;134m──────────────\u001b[0m "
        },

        {
            "type": "custom",
            "format":
                "         \u001b[38;2;235;111;146m\u001b[0m \u001b[38;2;246;193;119m\u001b[0m \u001b[38;2;235;188;186m\u001b[0m \u001b[38;2;49;116;143m\u001b[0m \u001b[38;2;156;207;216m\u001b[0m \u001b[38;2;196;167;231m\u001b[0m"
        },

        "break"
    ]
}